# Normalise line endings: LF in the repository, native on checkout.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and the Gradle wrapper must stay LF and executable.
*.sh text eol=lf
gradlew text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.pmtiles binary
*.gz binary
*.ttf binary
*.pbf binary

# Large generated data: keep diffs quiet
app/app/src/main/assets/dataset-seed.json -diff
backend/static/*.json -diff
design/canvas/*.html -diff
