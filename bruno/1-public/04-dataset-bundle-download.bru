meta {
  name: dataset bundle download
  type: http
  seq: 4
}

get {
  url: {{datasetUrl}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

docs {
  Follows the url announced by the manifest: exactly what the app downloads. With releases on disk this is /v1/datasets/N/<package>.
}

