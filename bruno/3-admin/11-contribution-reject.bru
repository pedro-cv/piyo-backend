meta {
  name: contribution reject
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/admin/contributions/{{contributionId}}/reject
  body: json
  auth: none
}

headers {
  X-Admin-Token: {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "note": "smoke"
  }
}

assert {
  res.status: in [200, 409]
}
